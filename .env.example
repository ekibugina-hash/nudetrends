# ────────────────────────────────────────────────
# Cloudflare R2 Storage Configuration
# ────────────────────────────────────────────────

# Your Cloudflare Account ID (found in the Cloudflare dashboard)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API Token — Access Key ID (generate under R2 > Manage API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id

# R2 API Token — Secret Access Key
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Name of your R2 bucket (e.g., nude-trends-media)
R2_BUCKET_NAME=your-r2-bucket-name

# Public custom domain for your R2 bucket (set under R2 bucket > Settings > Custom Domains)
# Do NOT include the trailing slash or https://
# Example: assets.nudetrends.afrozex.com
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=assets.nudetrends.afrozex.com

# ────────────────────────────────────────────────
# Admin Panel Authentication (SERVER-SIDE ONLY — no NEXT_PUBLIC_ prefix)
# ────────────────────────────────────────────────

# The admin login password. Checked on the server — never exposed to the client.
ADMIN_PASSWORD=changeme_use_strong_password

# A random secret used to sign the admin session cookie (HMAC-SHA256).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=your-random-64-char-hex-secret

# ────────────────────────────────────────────────
# Next.js App URL (used for sitemap and canonical URLs)
# ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nudetrends.afrozex.com
