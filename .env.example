# Copy this file to .env.local and fill in your values

APP_URL="https://nudetrends.afrozex.com"

# Cloudflare R2 Bucket — get tokens from dash.cloudflare.com > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="YOUR_BUCKET_NAME"

# R2 public domain (r2.dev URL or your custom CDN subdomain)
NEXT_PUBLIC_R2_PUBLIC_DOMAIN="YOUR_R2_PUBLIC_DOMAIN_WITHOUT_HTTPS"
